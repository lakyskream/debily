<!-- ================= JS: корзина + мобильное меню ================= -->
<script>
  // счётчик корзины: просто плюсуем при клике "Купить"
  let cartCount = 0;
  const cartCountEl = document.getElementById('cartCount');

  document.querySelectorAll('.buy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      cartCount++;
      cartCountEl.textContent = cartCount;
      btn.textContent = 'Добавлено ✓';
      setTimeout(() => { btn.textContent = 'Купить'; }, 1200);
    });
  });

  // открытие/закрытие мобильного меню по бургеру
  const burgerBtn = document.getElementById('burgerBtn');
  const mainNav = document.getElementById('mainNav');
  burgerBtn.addEventListener('click', () => {
    mainNav.classList.toggle('open');
  });

  // клик по кнопке корзины — просто заглушка-уведомление
  document.getElementById('cartBtn').addEventListener('click', () => {
    alert('Товаров в корзине: ' + cartCount + '. Оформление заказа пока не подключено — это просто шаблон.');
  });
</script>

